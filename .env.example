PORT=3000
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Admin dashboard login cookie signing key: openssl rand -hex 32
SESSION_SECRET=
DISCORD_DEV_GUILD_ID=
DISCORD_MEMBERS_INTENT=false
PUBLIC_URL=https://handcam.example.com
# LiveKit Cloud (cloud.livekit.io → your project → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MYSQL_URL=mysql://user:pass@localhost:3306/handcam
REDIS_URL=redis://localhost:6379
WORKER_SECRET=
STORAGE_DIR=/var/handcam/recordings
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RETENTION_DAYS=7
SAMPLE_FPS=2
RECORD_FPS=15
GRACE_SEC=10
VIOLATION_SEC=30
MENU_THRESHOLD=0.8
MENU_SHADOW=true
FREEZE_SEC=8
FREEZE_DIFF=0.3
LOOP_MATCH_RUN=20
EDGE_MARGIN_PX=8
MIN_SCREEN_AREA=0.15
MIN_BRIGHTNESS=40
DROP_SEC=20
LLM_SECOND_OPINION=false
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MIN_INTERVAL_SEC=60
DEFAULT_CAM_RES=480p
# Branding (cam page + dashboard). Logo: put the file in web/brand/ and set BRAND_LOGO_URL=/brand/logo.png
BRAND_NAME=HANDCAM
BRAND_TAGLINE=Match integrity check
# Theme: ranger (olive drab), steel (urban gunmetal) or nightops (night-vision green)
BRAND_THEME=ranger
# Optional: override the theme's accent colour, e.g. #E5193B
BRAND_ACCENT=
BRAND_LOGO_URL=
# Your own background art (darkened automatically), e.g. /brand/bg.jpg
BRAND_BG_URL=
CAM_LINK_TTL_MIN=30
